# Copie para .env e preencha. NUNCA versione o .env.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
SEGREDO_JWT=troque-por-um-segredo-longo-e-aleatorio
PORT=3001
LOG_PATH=./logs

# Opcional: origens permitidas no CORS (só se o navegador chamar a API direto). Ex.: http://localhost:3002
CORS_ORIGINS=
# Opcional: 1 quando a API estiver atrás de proxy/túnel (Cloudflare Tunnel, Nginx). Deixe vazio se exposta direto.
TRUST_PROXY=
